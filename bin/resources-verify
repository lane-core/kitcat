#!/usr/bin/env bash
# shellcheck disable=SC2016
# (SC2016: '$1'/'$2' in single quotes below are rg -r replacement
# tokens, deliberately unexpanded by the shell.)
set -euo pipefail

# resources-verify — mechanical custody check for resources/ entries.
#
# For every entry README, read the custody frontmatter (the
# machine-parseable surface; resources/README.md "Entry format" is
# the schema authority) and re-verify each recorded artifact hash
# against the vendored file beside it — the canonical
# `artifact`/`sha256` pair, plus the `secondary-artifact`/
# `secondary-sha256` pair when present. `sha256-inner` is a
# re-fetch fallback with no on-disk target and is not checked.
# The four required keys — `artifact`, `sha256`, `format`,
# `fetch-url` — must all be present; a missing one is FATAL.
# `fetch-url: none` is the valid explicit no-public-URL record.
#   - a mismatch is FATAL (exit 1) — the entry describes a different
#     document than the one on disk; resolve before citing anything;
#   - an absent file is reported MISSING (informational) — vendored
#     artifacts are gitignored, so a fresh clone legitimately lacks
#     them; re-fetch per the entry's frontmatter `fetch-url`.
#
# --remote additionally reports, for each arXiv-identified entry, the
# latest version on arxiv.org beside what the entry records (the
# frontmatter `version:` pin when the id is the entry's own, else
# the README's inline citation), so version drift is visible.
# Informational: the reader judges; an unreachable network is
# reported, never silently ignored.

# rg exits 1 when nothing matches — an empty set here, not an error.
# Any other nonzero status is a real failure and must propagate.
rg_allow_empty() { rg "$@" || [ $? -eq 1 ]; }

# Read one flat scalar key from an entry README's YAML frontmatter
# (the block between the opening '---' on line 1 and the closing
# '---'). Prints the value, or nothing when the file has no
# frontmatter or lacks the key.
fm_get() { # fm_get <readme> <key>
    awk -v key="$2" '
        NR == 1 { if ($0 != "---") exit; next }
        /^---$/ { exit }
        index($0, key ": ") == 1 { print substr($0, length(key) + 3); exit }
    ' "$1"
}

cd "$(git rev-parse --show-toplevel)"

remote=false
for arg in "$@"; do
    case "$arg" in
        --remote) remote=true ;;
        -h|--help)
            echo "Usage: resources-verify [--remote]"
            echo "Verify frontmatter-recorded hashes against vendored artifacts;"
            echo "--remote also reports latest arXiv versions."
            exit 0 ;;
        *) echo "resources-verify: unknown argument '$arg'" >&2; exit 2 ;;
    esac
done

entries=0 checked=0 missing=0 fatal=0

check_hash() { # check_hash <entry> <dir> <file> <hash>
    local entry="$1" dir="$2" file="$3" hash="$4" target actual
    target="${dir}${file}"
    if [ ! -f "$target" ]; then
        echo "  ${entry}: MISSING ${file} — vendored artifact absent; re-fetch per the entry's fetch-url"
        missing=$((missing + 1))
        return
    fi
    actual="$(shasum -a 256 "$target" | awk '{print $1}')"
    if [ "$actual" = "$hash" ]; then
        checked=$((checked + 1))
    else
        echo "  ${entry}: FATAL hash mismatch on ${file}"
        echo "    recorded: ${hash}"
        echo "    actual:   ${actual}"
        fatal=$((fatal + 1))
    fi
}

for dir in resources/*/; do
    readme="${dir}README.md"
    [ -f "$readme" ] || continue
    entries=$((entries + 1))
    entry="$(basename "$dir")"

    artifact="$(fm_get "$readme" artifact)"
    hash="$(fm_get "$readme" sha256)"
    format="$(fm_get "$readme" format)"

    # Required-key policing: the schema (resources/README.md
    # "Entry format") makes artifact, sha256, format, and fetch-url
    # mandatory on every entry. `fetch-url: none` is the valid
    # explicit no-public-URL record, so presence is what is
    # checked, never a URL shape.
    for key in artifact sha256 format fetch-url; do
        if [ -z "$(fm_get "$readme" "$key")" ]; then
            echo "  ${entry}: FATAL missing required frontmatter key '${key}'" \
                 "— see resources/README.md \"Entry format\""
            fatal=$((fatal + 1))
        fi
    done

    case "$format" in
        latex-source|source-tree|html|pdf|scan) ;;
        "") ;; # Already reported by required-key policing above.
        *)
            echo "  ${entry}: FATAL unknown format '${format}'" \
                 "— expected latex-source, source-tree, html, pdf, or scan"
            fatal=$((fatal + 1))
            ;;
    esac

    if [ "$format" = "source-tree" ] && [ -z "$(fm_get "$readme" version)" ]; then
        echo "  ${entry}: FATAL source-tree requires an immutable revision in 'version'"
        fatal=$((fatal + 1))
    fi

    if [ -n "$artifact" ] && [ -n "$hash" ]; then
        check_hash "$entry" "$dir" "$artifact" "$hash"
        sec_artifact="$(fm_get "$readme" secondary-artifact)"
        sec_hash="$(fm_get "$readme" secondary-sha256)"
        if [ -n "$sec_artifact" ] && [ -n "$sec_hash" ]; then
            check_hash "$entry" "$dir" "$sec_artifact" "$sec_hash"
        elif [ -n "$sec_artifact" ] || [ -n "$sec_hash" ]; then
            echo "  ${entry}: FATAL secondary-artifact/secondary-sha256 must appear as a pair"
            fatal=$((fatal + 1))
        fi
    fi

    if $remote; then
        fm_meta="$(fm_get "$readme" metadata-url)"
        fm_version="$(fm_get "$readme" version)"
        while read -r id; do
            [ -n "${id:-}" ] || continue
            abs="$(curl -sfL --max-time 20 "https://arxiv.org/abs/${id}" 2>/dev/null)" || {
                echo "  ${entry}: arXiv ${id} UNREACHABLE — version drift not checked"
                continue
            }
            latest="$(printf '%s' "$abs" | rg_allow_empty -o '\[v([0-9]+)\]' -r 'v$1' | tail -1)"
            # The frontmatter version pin speaks only for the
            # entry's own id (the one its metadata-url names); any
            # other id cited in the README falls back to the inline
            # citation form.
            if [ -n "$fm_version" ] && [ "${fm_meta##*/}" = "$id" ]; then
                recorded="${fm_version} (frontmatter pin)"
            else
                recorded="$(rg_allow_empty -o -m1 "arXiv:${id}v?[0-9]*" "$readme" | head -1)"
            fi
            echo "  ${entry}: arXiv ${id} latest ${latest:-unknown} (entry records: ${recorded:-no version pin})"
        done < <(rg_allow_empty -o -N 'arXiv:\s?([0-9]{4}\.[0-9]{4,5})' -r '$1' "$readme" | sort -u)
    fi
done

if [ "$entries" -eq 0 ]; then
    echo "resources-verify: no entries found under resources/" >&2
    exit 1
fi

# Entry standing (informational), per the format authority: the
# load-bearing gate is the statement audit (human-free); Lane's
# `Vetted:` line is self-initiated discretion, never a queue the
# pipeline waits on. Also report consumption — which tracked kitcat
# artifacts cite each entry (reverse grep, kitcat-side, so entries
# stay source-only). An entry nothing consumes failed the usefulness
# criterion regardless of its audit status.
echo "── entry standing ──"
for dir in resources/*/; do
    readme="${dir}README.md"
    [ -f "$readme" ] || continue
    entry="$(basename "$dir")"

    # Parse the audited fraction out of a line-anchored "Statements
    # verified: N/M" field (same anchor as the Vetted check below, so a
    # README that merely MENTIONS the field name in prose never
    # acquires standing — found live by the bentzen ingest). Two field
    # shapes both mean full coverage: a bare "N/M CONFIRMED" with N ==
    # M, and "N CONFIRMED on first pass, K CORRECTED" where every one
    # of M items was read and K of them needed a fix (N + K == M). Only
    # N < M with no CORRECTED clause is a genuine partial audit — some
    # digests were never independently read at all.
    field="$(rg_allow_empty -oi '^\s*-?\s*Statements verified:.*' "$readme" | head -1)"
    fraction="$(printf '%s' "$field" | rg_allow_empty -o '([0-9]+)/([0-9]+)' -r '$1/$2' | head -1)"
    partial=false
    if [ -n "$fraction" ]; then
        n="${fraction%/*}"
        m="${fraction#*/}"
        if [ "$n" -lt "$m" ] && ! printf '%s' "$field" | rg -qi 'CORRECTED'; then
            partial=true
        fi
    fi

    if rg -qi '^\s*-?\s*Vetted:' "$readme"; then
        standing="vetted (Lane discretion exercised)"
    elif $partial; then
        standing="PARTIAL audit (${fraction} CONFIRMED) — load-bearing only for the audited digests; Lane discretion open"
    elif [ -n "$field" ]; then
        standing="audited — load-bearing capable${fraction:+ (${fraction} CONFIRMED)}; Lane discretion open"
    else
        standing="NOT audited — supports nothing load-bearing"
    fi
    # Consumers: tracked files outside resources/ citing the entry.
    consumers="$(git grep -l "resources/${entry}" -- ':!resources' 2>/dev/null | tr '\n' ' ' || true)"
    if [ -n "$consumers" ]; then
        echo "  ${entry}: ${standing}; consumed by: ${consumers}"
    else
        echo "  ${entry}: ${standing}; consumed by: NOTHING (usefulness flag)"
    fi
done

echo "resources-verify: ${entries} entries, ${checked} hashes verified, ${missing} missing, ${fatal} FATAL"
[ "$fatal" -eq 0 ]
