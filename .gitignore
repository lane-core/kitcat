src/Test/**

# outputs/ dot-directories are local working memory (run plans, research
# intermediates, prove-loop state); the durable layer that IS tracked is
# outputs/*.md finals + provenance sidecars, papers/, notes/, CHANGELOG.md.
/outputs/.plans/
/outputs/.drafts/
/outputs/.notes/
/outputs/.prove/

# resources/: vendored source documents and derived forms are local-only;
# only the entry README (citation, hash, line-anchored map) is tracked.
resources/**/snapshot/**
resources/**/*.pdf
resources/**/*.ps
resources/**/*.djvu
resources/**/*.gz
resources/**/*.tar
resources/**/*.pdftext
resources/**/*.tex
resources/**/*.agda
resources/**/*.sty
resources/**/*.cls
resources/**/*.html
